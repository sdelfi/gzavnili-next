# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/docker/data/postgres/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by typed-css-modules (`bun run css-types`) — regenerated by predev/prebuild
*.module.css.d.ts

# generated by `prisma generate` (postinstall / bun run db:generate)
/src/generated/prisma

/tmp

# bema "Files" (docs/decisions/0032-bema-files.md) — admin-uploaded content, not source.
/public/uploads/