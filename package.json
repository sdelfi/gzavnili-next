{
  "name": "gzavnili-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "bun run css-types",
    "dev": "next dev",
    "prebuild": "bun run css-types",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css-types": "tcm src -p '**/*.module.css' --camelCase",
    "db:generate": "prisma generate",
    "db:migrate": "bun scripts/guard-local-db.mjs && prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "bun scripts/guard-local-db.mjs && prisma studio",
    "db:seed": "bun scripts/seed-admin.ts && bun scripts/seed-message-types.ts && bun scripts/seed-delivery-offices.ts && bun scripts/seed-parcel-shippers.ts",
    "import:legacy-pages": "bun scripts/guard-local-db.mjs && bun scripts/import-legacy-pages.ts",
    "test": "bun test",
    "benchmark:parcels": "bun scripts/benchmark-parcels.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "classnames": "^2.5.1",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "nodemailer": "^9.0.3",
    "normalize.css": "^8.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-select": "^5.10.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "prisma",
    "@prisma/client",
    "@prisma/engines"
  ]
}
