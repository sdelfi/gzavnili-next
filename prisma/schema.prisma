// Phase 1 schema (see docs/migrations/04-postgres-schema-design.md and
// docs/decisions/0010-prisma-migrations.md). This is a redesign, not a 1:1 port of the
// legacy MSSQL `gzavnili` database — see docs/migrations/05-data-migration-strategy.md for
// why a mechanical column copy is explicitly the wrong approach for the `parcels` domain.
//
// Naming convention: camelCase in Prisma/TS, snake_case in Postgres (via @map/@@map) —
// the legacy MSSQL schema uses PascalCase columns (TrackingNum, UserId, ...); this project
// deliberately does not carry that convention forward.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// --- Parcel status -----------------------------------------------------------------
//
// Replaces the legacy non-sargable `CASE WHEN len(TrackingX) > 1 ...` waterfall
// (docs/migrations/02-parcels-domain-analysis.md §2.1) with a real, maintained column.
// The priority order below (not_on_hold > on_hold > delivered > ... > new) matches the
// bema admin list query, per docs/migrations/04-postgres-schema-design.md §1 — chosen as
// the default/provisional order. The single-parcel `read()` legacy endpoint checks
// `delivered` *before* the hold flags, a discrepancy flagged as an open business question
// in docs/migrations/07-risks-and-open-questions.md (open question #1), NOT YET
// confirmed by the client. Do not treat this ordering as final without that sign-off —
// see the `fn_recompute_parcel_status` function body (in the initial migration) for the
// single place this precedence is encoded.
enum ParcelStatus {
  New              @map("new")
  Awaiting         @map("awaiting")
  Received         @map("received")
  Shipped          @map("shipped")
  Delay            @map("delay")
  Custom           @map("custom")
  ProcessingCustom @map("processing_custom")
  Office           @map("office")
  OutDelivery      @map("out_delivery")
  Region           @map("region")
  Delivered        @map("delivered")
  OnHold           @map("on_hold")
  NotOnHold        @map("not_on_hold")

  @@map("parcel_status")
}

// --- Auth / bema admin (docs/migrations/06-phased-rollout-plan.md Phase 4, implemented
// early as the first bema slice: auth + user management) -----------------------------
//
// The legacy system has exactly one `users` table for both bema admin accounts and
// customer accounts, distinguished by `TypeId` (1=BEMA/2=Customer) plus a `users_groups`
// junction table that dual-purposes as "admin role" for bema accounts and "discount tier"
// for customer accounts (see the legacy-research notes this schema is based on). This
// pass deliberately simplifies that: `accountType` replaces `TypeId`, and `adminRole`
// replaces the `users_groups`/`groups` join for the bema-admin-role case only — every
// legacy account only ever effectively had one active admin role at a time despite the
// junction-table modeling, so collapsing it to a single enum column loses no real
// behavior. Customer discount/wholesale tiers are explicitly OUT of scope for this pass
// (the legacy `groups` table's other purpose) — `customer_pricing_rules` already exists
// as a separate, more modern mechanism per docs/migrations/02-parcels-domain-analysis.md
// §4's "unrelated to parcels" note.
enum AccountType {
  Customer @map("customer")
  BemaUser @map("bema_user")

  @@map("account_type")
}

// WEBSITE_ADMINISTRATOR / ADMINISTRATOR / AGENT_ADMINISTRATOR in the legacy `User.cfc`
// GROUPS constant. `STANDARD`/`CONTENT_ONLY`/`SALES_MANAGER` legacy roles were never
// observed actually gating any bema screen in the current codebase and are not carried
// forward — add them back explicitly if a real use is found.
enum AdminRole {
  BemaStandard      @map("bema_standard")
  BemaAdministrator @map("bema_administrator")
  BemaAgent         @map("bema_agent")

  @@map("admin_role")
}

model User {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username          String   @unique
  email             String   @unique
  firstName         String?  @map("first_name")
  lastName          String?  @map("last_name")
  organization      String?
  billingAddressId  String?  @map("billing_address_id") @db.Uuid
  billingAddress    Address? @relation("UserBillingAddress", fields: [billingAddressId], references: [id])
  shippingAddressId String?  @map("shipping_address_id") @db.Uuid
  shippingAddress   Address? @relation("UserShippingAddress", fields: [shippingAddressId], references: [id])
  balanceAdjust     Decimal  @default(0) @map("balance_adjust") @db.Decimal(12, 2)
  // Free-text import-batch identifier, matching the legacy `ImportId` column exactly
  // (legacy "Edit Customer" screen: "Import Id") — not modeled further since no ETL import
  // job exists yet to give it real meaning.
  importId          String?  @map("import_id")
  // Legacy CF password hashes (SHA-1(password + salt), the same scheme for both bema and
  // customer accounts) likely can't be verified by a new KDF without knowing the exact
  // legacy scheme — see docs/migrations/07-risks-and-open-questions.md ("Password hash
  // migration"). New accounts created directly in this schema use `passwordAlgo =
  // "argon2id"` (via Bun.password, see src/lib/auth/password.ts) from the start; a future
  // ETL import of legacy accounts would set `passwordAlgo = "legacy-sha1"` and re-hash on
  // next successful login instead of attempting to migrate the hash itself.
  passwordHash      String?  @map("password_hash")
  passwordAlgo      String?  @map("password_algo")
  // Legacy "short password"/PIN (`PasswordShort` in MSSQL) used by the bema idle-lock modal
  // and money-collect screens to re-authenticate — and, if it matches a *different* active
  // BemaUser's short password, to switch the session to that user (see
  // extensions/components/DAO/MSSQL/MSSQLUserDAO.cfc's `validatePasswordShort`). Legacy
  // stores this in plaintext with a bare SQL equality lookup across all users; we
  // deliberately store it hashed (Bun.password, same as passwordHash) and verify by
  // iterating active BemaUser candidates instead — see docs/decisions/0011-bema-admin.md's
  // idle-lock section for why this is a safety improvement, not a behavior change.
  passwordShortHash String?  @map("password_short_hash")

  accountType AccountType @default(Customer) @map("account_type")
  adminRole   AdminRole?  @map("admin_role")

  active                 Boolean   @default(true)
  confirmed              Boolean   @default(false)
  lockoutEnabled         Boolean   @default(false) @map("lockout_enabled")
  lockoutExpiresAt       DateTime? @map("lockout_expires_at") @db.Timestamptz(6)
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(6)

  // 'en'/'ge' — matches the locale ids already used by next-intl (docs/decisions/0008).
  language String? @default("en")

  // Legacy "Edit Customer" screen's "Notification Type: [x] Via mail [ ] Via SMS" row —
  // the delivery-channel toggles, separate from *which* events notify (below).
  notifyViaMail Boolean @default(true) @map("notify_via_mail")
  notifyViaSms  Boolean @default(false) @map("notify_via_sms")

  // BEMA-only fields (legacy: only shown/editable when accountType = BemaUser).
  suffix     String?
  // The flat per-kg rate a BEMA Agent charges on the batch "Add Parcel" screen instead of the
  // customer's normal pricing (`parcels-add.js`'s `isAgent && agentPrice` branch) — a real
  // numeric rate in legacy (`vwUserEditForm.cfm`'s `<input type="number" step="0.01">`), not
  // the bare flag this was previously simplified to. See docs/findings.md.
  agentPrice Decimal? @map("agent_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parcels        Parcel[]              @relation("ParcelUser")
  /// Edit-log rows this account authored — the reports' "which admin collected this".
  parcelEdits    ParcelHistory[]       @relation("ParcelHistoryUpdater")
  /// Money-collect records where this account is the *agent being collected from* — see
  /// `MoneyCollectHistory`'s comment for why the collecting manager isn't a second relation.
  moneyCollected MoneyCollectHistory[] @relation("MoneyCollectAgent")
  receivers      Receiver[]
  invoices       Invoice[]
  payments       Payment[]
  balance        UserBalance?
  pricingRules   CustomerPricingRule[]

  // Legacy "Edit Customer" screen's per-event notification checkbox grid ("Parcel was
  // picked up", "We just got your parcel(s)", ...) — which MessageTypes this account
  // wants to be notified for, independent of the mail/SMS channel toggles above.
  notificationMessageTypes MessageType[] @relation("UserNotificationPreferences")

  @@index([accountType])
  @@map("users")
}

// Login attempt audit trail — also drives the lockout logic (N failures since
// lastLoginAt within a window locks the account), mirroring the legacy `securitylog`
// table's role in `MSSQLUserDAO.validateLogin`.
model SecurityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String
  event     String
  username  String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([username, createdAt])
  @@map("security_log")
}

model Address {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  firstNameGe   String? @map("first_name_ge")
  lastNameGe    String? @map("last_name_ge")
  title         String?
  organization  String?
  // Shipping-address-only field on the legacy "Edit Customer" screen (not shown for
  // billing) — kept nullable/generic here rather than splitting Address into two models.
  email         String?
  city          String?
  state         String?
  country       String?
  postalCode    String? @map("postal_code")
  street1       String?
  street2       String?
  // Five distinct phone-ish fields, matching the legacy "Edit Customer" contact-info
  // layout exactly (Private Number / Cell Phone / Work Phone / Home Phone / Fax) — this
  // replaces an earlier, less faithful `phone1`/`phone2`/`phone3` naming from before this
  // screen's full field set was cross-checked against the live site.
  privateNumber String? @map("private_number")
  cellPhone     String? @map("cell_phone")
  workPhone     String? @map("work_phone")
  homePhone     String? @map("home_phone")
  fax           String?

  usersAsBilling  User[]     @relation("UserBillingAddress")
  usersAsShipping User[]     @relation("UserShippingAddress")
  receivers       Receiver[]

  @@map("addressbook")
}

// Legacy "Edit Customer" screen's per-event notification checkbox grid — "queried live
// from a messageTypes table" per the legacy-research notes this schema is based on.
// Seeded once via prisma/seed-message-types.ts (bun run db:seed), not user-editable yet
// (no bema screen manages this list — it's a fixed reference table for now).
model MessageType {
  key       String @id
  label     String
  sortOrder Int    @map("sort_order")

  users User[] @relation("UserNotificationPreferences")

  @@map("message_types")
}

enum ServiceType {
  Regular @map("regular")
  Express @map("express")
  Cargo   @map("cargo")

  @@map("service_type")
}

enum PricingRuleMode {
  FixedPrice @map("fixed_price")
  Discount   @map("discount")

  @@map("pricing_rule_mode")
}

// "Pricing Rules (Custom Rates & Discounts)" on the legacy "Edit Customer" screen —
// per-customer shipping rate overrides/discounts by service type and date range. Matches
// `customer_pricing_rules`, the one place docs/migrations/02-parcels-domain-analysis.md §4
// notes the legacy team already made ad hoc raw-SQL schema changes (`database/
// migration_add_audit_columns.sql`, `migration_add_overlap_trigger.sql`) — i.e. this table
// already exists in the legacy DB and predates the parcels-domain redesign generally.
// The legacy "Status" column (Active/Inactive) is keyed purely off `IsActive`/`DeletedDate`,
// independent of whether `validFrom`/`validTo` has actually expired — that's `isActive`
// below, not derived. Legacy also enforces "no overlapping active rule for the same
// user+serviceType" via a DB trigger (`database/migration_add_overlap_trigger.sql`); this
// app has no direct-DB write path, so the same check is done in the API route layer instead
// (see docs/findings.md) rather than as a hand-authored Postgres trigger.
model CustomerPricingRule {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id])
  serviceType ServiceType     @map("service_type")
  mode        PricingRuleMode
  // Interpreted per `mode`: a flat USD/KG price when `FixedPrice`, a percentage when
  // `Discount` — matching the legacy form's "USD per KG" hint text under this field.
  value       Decimal         @db.Decimal(10, 2)
  validFrom   DateTime        @map("valid_from") @db.Date
  validTo     DateTime?       @map("valid_to") @db.Date
  notes       String?

  // Soft-delete flag — legacy "Remove" deactivates (IsActive=0) rather than deleting, and
  // "Restore" flips it back; a hard DELETE never happens in the legacy admin UI.
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Free-text username of the acting admin, not an FK — matches the legacy "Created By"/
  // "Modified By" columns, which are plainly display-only audit fields, not a real
  // relation any other feature needs to join against.
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by")

  @@index([userId])
  @@map("customer_pricing_rules")
}

model Receiver {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Legacy `receivers.isgecitizen`. Decides which name pair the parcel form requires (the
  // Georgian-script one rather than the Latin one) and is printed on customs paperwork, so
  // it is a fact about the person, not something to infer: a Georgian citizen whose name
  // happens to be recorded only in Latin is still a Georgian citizen. Was briefly derived
  // from "does a Georgian-script name exist" while this column was missing — see
  // docs/decisions/0015.
  isGeCitizen Boolean @default(false) @map("is_ge_citizen")
  // Legacy `receivers.Status` — the standalone Receivers admin screen (`receivers-delete.cfm`)
  // soft-deletes by setting this to 0 rather than removing the row, since a receiver already
  // attached to past parcels can't be hard-deleted without orphaning them.
  active      Boolean @default(true)
  // Not explicitly enumerated in docs/migrations/02-parcels-domain-analysis.md (which only
  // confirms ReceiverId/AddressId) — inferred so "my receivers" can be scoped per sender.
  // Verify against the legacy `receivers` table before the ETL backfill in
  // docs/migrations/05-data-migration-strategy.md relies on it.
  userId      String? @map("user_id") @db.Uuid
  user        User?   @relation(fields: [userId], references: [id])
  addressId   String  @map("address_id") @db.Uuid
  address     Address @relation(fields: [addressId], references: [id])

  parcels Parcel[]

  @@index([userId])
  @@map("receivers")
}

model DeliveryOffice {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeName     String  @map("office_name")
  officeNameGe   String? @map("office_name_ge")
  city           String?
  letter         String?
  searchPatterns String? @map("search_patterns")

  parcelOffices ParcelOffice[]

  @@map("delivery_offices")
}

model ParcelOffice {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // One current office assignment per parcel — matches the legacy `TOP 1` lookup in
  // docs/migrations/02-parcels-domain-analysis.md §2.2. History of prior office
  // reassignments is not tracked, same as the legacy system.
  parcelId String         @unique @map("parcel_id") @db.Uuid
  parcel   Parcel         @relation(fields: [parcelId], references: [id])
  officeId String         @map("office_id") @db.Uuid
  office   DeliveryOffice @relation(fields: [officeId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@index([officeId])
  @@map("parceloffice")
}

model Invoice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  invoiceDate DateTime @map("invoice_date") @db.Timestamptz(6)

  items             InvoiceItem[]
  invoicedOnParcels Parcel[]      @relation("ParcelInvoice")

  @@index([userId, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  parcelId  String  @map("parcel_id") @db.Uuid
  parcel    Parcel  @relation(fields: [parcelId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@index([parcelId])
  @@index([invoiceId])
  @@map("invoices_items")
}

model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  paymentDate     DateTime @map("payment_date") @db.Timestamptz(6)
  amount          Decimal  @db.Decimal(12, 2)
  // e.g. 'balance', or a payment-gateway identifier — kept as a free-form string, matching
  // the legacy column's usage (excludes 'balance' from user_balances.paid_amount, per
  // docs/migrations/02-parcels-domain-analysis.md §2.2).
  paymentMethodId String   @map("payment_method_id")

  @@index([userId, paymentDate])
  @@map("payments")
}

// Single-row operational settings table (legacy `config`) — a cross-cutting dependency for
// multiple modules (docs/migrations/01-current-state-audit.md §risk register), migrated
// early per docs/migrations/06-phased-rollout-plan.md Phase 1. `id` is pinned to 1 via a
// CHECK constraint added in the initial migration (see migration.sql) so a second row can
// never be inserted by accident.
model Config {
  id            Int       @id @default(1)
  crate         String?
  dtExpressShip DateTime? @map("dt_express_ship") @db.Timestamptz(6)
  dtExpressEst  DateTime? @map("dt_express_est") @db.Timestamptz(6)
  dtRegularShip DateTime? @map("dt_regular_ship") @db.Timestamptz(6)
  dtRegularEst  DateTime? @map("dt_regular_est") @db.Timestamptz(6)
  // The two "current trip" AWB codes. Setting a parcel's AWB to one of these (bema parcels
  // list → "Set AWB" bulk operation) is what stamps that trip's estimated ship/delivery
  // dates onto the parcel — see `applyAwbOperation` in src/lib/services/parcelOperations.ts,
  // ported from the legacy `MSSQLParcelDAO.doOperation()`'s `awb` branch. `regAwb` was
  // missing from this model until the parcels list screen needed it (only `expAwb` had been
  // carried over); the legacy `config` table has both.
  expAwb        String?   @map("exp_awb")
  regAwb        String?   @map("reg_awb")

  // Cargo Services shipping dates (bema "Site Settings" screen, legacy `dtCargoShip`/
  // `dtCargoEst` columns). Cargo has no AWB code column of its own in legacy either — only
  // Regular/Express do (`regAwb`/`expAwb` above) — so there's no `cargoAwb` field to add.
  dtCargoShip DateTime? @map("dt_cargo_ship") @db.Timestamptz(6)
  dtCargoEst  DateTime? @map("dt_cargo_est") @db.Timestamptz(6)

  // The air-cargo manifest header fields ("Export Airway" on the parcels list reads these —
  // see `src/app/api/bema/parcels/export-airway/route.ts`). `airwayBill` and `consignee` are
  // legacy `AirwayBill`/`Consignee`; distinct from `regAwb`/`expAwb` above, which are the
  // *trip* AWB codes, not this manifest's own bill number.
  airwayBill String?   @map("airway_bill")
  airwayDate DateTime? @map("airway_date") @db.Timestamptz(6)
  consignee  String?   @map("consignee")

  // Bema "Site Settings" → "Header Site Message" textarea (legacy `SiteMessage`). Only ever
  // displayed by legacy's `views/layouts/default.html` (the `error.cfm` page's layout) — this
  // app has no equivalent custom error-page layout, so the field is editable here for parity
  // with the legacy screen but currently has no display consumer. See docs/findings.md.
  // `SiteMessage2` is NOT modeled: confirmed write-only and never rendered by any legacy view
  // (not even `vwSettings.cfm` has an input for it) — see docs/findings.md.
  siteMessage String? @map("site_message")

  // "Price for parcels" section — legacy `declaredPrice`/`nonDeclaredPrice`, read by
  // `lytBema.cfm`'s `dbConfig` and used client-side in `parcels-online-add-2.js`'s declared-
  // vs-non-declared pricing toggle. That toggle isn't ported yet (out of scope for this
  // change, tracked in docs/findings.md); stored here so the settings screen itself is
  // complete and the values are ready for that future consumer.
  declaredPrice    String? @map("declared_price")
  nonDeclaredPrice String? @map("non_declared_price")

  // Site-wide announcement popup (bema "Site Settings" → "Popup" section; legacy `config`
  // table's `ePopup`/`PopupMessageen`/`PopupMessagege` columns, shown via
  // `views/layouts/new.html`'s `.message-popup` on every page unless a `showpopup` cookie is
  // already set). Legacy shows the popup whenever `ePopup = 1`, **even if the message text
  // is blank** — a real bug (an admin can enable the flag with no message and every visitor
  // gets an empty popup) — fixed in `SitePopup.tsx`, which additionally requires non-empty
  // `popupMessageEn`/`popupMessageGe` before rendering, not modeled here since it's
  // display-logic, not a schema concern.
  popupEnabled   Boolean @default(false) @map("popup_enabled")
  popupMessageEn String? @map("popup_message_en")
  popupMessageGe String? @map("popup_message_ge")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("config")
}

// New in this schema (docs/migrations/04-postgres-schema-design.md §2): the user-level
// `paidamount`/`invoiceamount` aggregate that the legacy query recomputed identically for
// every parcel row belonging to that user — the single worst offender in
// docs/migrations/02-parcels-domain-analysis.md §2.2. Maintained by a trigger on
// payments/invoices writes (see migration.sql), read once per list query instead.
model UserBalance {
  userId        String   @id @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  invoiceAmount Decimal  @default(0) @map("invoice_amount") @db.Decimal(12, 2)
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_balances")
}

// Trigger-maintained projection of `parcels.status` transitions — every status change,
// whatever code path caused it (docs/migrations/04-postgres-schema-design.md §1). This is a
// *status* timeline, deliberately narrow: it answers "when did this parcel become Shipped".
// It is NOT the general edit log — that's `ParcelHistory` below, which records field-level
// edits with old/new values, payment details and the acting admin. The two coexist on
// purpose: this one is written automatically by a DB trigger and can never be forgotten by a
// caller; that one carries the business detail a trigger can't know (who was logged in, which
// payment method was taken). See docs/decisions/0018-parcel-edit-history.md.
model ParcelStatusHistory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parcelId  String       @map("parcel_id") @db.Uuid
  parcel    Parcel       @relation(fields: [parcelId], references: [id])
  status    ParcelStatus
  changedAt DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy String?      @map("changed_by")
  reason    String?

  @@index([parcelId, changedAt])
  @@map("parcel_status_history")
}

// The legacy `ParcelHistory` table, ported (docs/decisions/0018-parcel-edit-history.md).
//
// An earlier phase of this migration dropped it on the mistaken premise that legacy had no
// audit trail "outside the write-only `operations` table" — it does, and every table on the
// bema "Parcels Reports" screen is built on it. Restored here because the reports genuinely
// cannot work without it: it is the only record of *what a payment was at the moment it was
// taken* (`payMethod`/`payAmount` per event, not the parcel's current overwritable columns)
// and of *which admin* did it.
//
// Column names/semantics mirror legacy 1:1 so the ETL import is a straight copy and the
// report queries port literally. Two deliberate storage improvements that change nothing
// observable:
//   * `updaterId` is a real FK to `users` (legacy stored a bare unindexed GUID string), so
//     the reports' "which admin collected this" join is a normal indexed join.
//   * `updater` — legacy's denormalized "First Last (username)" display string — is kept
//     because it is NOT always derivable from `updaterId`: `money-collect.cfm`'s backfill
//     writes `updater = 'Online'` with a NULL `updaterid` for payments that had no operator
//     at all. Dropping it would lose that distinction.
//
// Indexes: legacy has none anywhere (docs/migrations/02-parcels-domain-analysis.md §5) and
// the reports are correspondingly slow. The three below are chosen for this screen's actual
// query shapes — equality column first, then the range column, so each is a single index
// scan rather than a full-table scan plus filter.
model ParcelHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parcelId     String   @map("parcel_id") @db.Uuid
  parcel       Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  editDateTime DateTime @default(now()) @map("edit_date_time") @db.Timestamptz(6)

  /// Legacy `EditStatus`: the parcel's status at edit time, or a literal marker for the
  /// events that aren't field edits (`Added`, `Set AWB`, `Unpaid`, `Operation changed`).
  editStatus String? @map("edit_status")
  /// Which field changed (`Merchant`/`Content`/`Value`/`Debt`/`Paid`/`Partial Paid`/`amount`),
  /// blank for the whole-record events. The reports key off this: `valueName = 'Paid'` is
  /// what makes a row a payment event.
  valueName  String? @map("value_name")
  oldValue   String? @map("old_value")
  newValue   String? @map("new_value")

  /// Payment method/amount **as taken at this moment** — the whole reason this table can't be
  /// reconstructed from `parcels.pay_method1`/`pay_amount1`, which later edits overwrite.
  payMethod String?  @map("pay_method")
  payAmount Decimal? @map("pay_amount") @db.Decimal(12, 2)

  updaterId   String? @map("updater_id") @db.Uuid
  updater     User?   @relation("ParcelHistoryUpdater", fields: [updaterId], references: [id])
  /// Legacy's denormalized display string — see the model comment for why it survives.
  updaterName String? @map("updater_name")

  /// Payment events in a date window — the Total Sale / Payment Colected / Remain Payment
  /// tables and the "Paid transactions" tab all start here.
  @@index([valueName, editDateTime])
  /// One parcel's timeline, and the reports' per-parcel dedupe.
  @@index([parcelId, editDateTime])
  /// "Colected In USA"/"Colected In Georgia": group a window's payment events by admin.
  @@index([updaterId, editDateTime])
  @@map("parcel_history")
}

// "Money collect" (legacy `bema/parcels/money-collect.cfm` + `MoneyCollectHistory` table) —
// records that a manager physically collected an agent's accumulated cash/card/deposit/wire
// takings for one calendar day. A new table for this port (not an ETL target), so it's named
// for what it actually holds rather than mirroring legacy's misleading `CollectorId` column
// (which in legacy stores the collecting manager's *username*, joined via `users.username`,
// not a real foreign key — see docs/findings.md).
model MoneyCollectHistory {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  user   User     @relation("MoneyCollectAgent", fields: [userId], references: [id])
  /// The calendar day being collected for — matched against `parcel_history.edit_date_time`
  /// by day only, same grouping the report itself uses.
  cDate  DateTime @map("c_date") @db.Timestamptz(6)

  aCash         Decimal @default(0) @map("a_cash") @db.Decimal(12, 2)
  aCreditCard   Decimal @default(0) @map("a_credit_card") @db.Decimal(12, 2)
  aBankDeposit  Decimal @default(0) @map("a_bank_deposit") @db.Decimal(12, 2)
  aWireTransfer Decimal @default(0) @map("a_wire_transfer") @db.Decimal(12, 2)
  collected     Decimal @db.Decimal(12, 2)

  collectorUsername String   @map("collector_username")
  /// The manager-supplied "Date" field on the collect modal — distinct from `cDate` (the day
  /// being collected for) and from `createdAt` (when the record was actually inserted).
  gDate             DateTime @default(now()) @map("g_date") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, cDate])
  @@map("money_collect_history")
}

model Parcel {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation("ParcelUser", fields: [userId], references: [id])
  receiverId String?   @map("receiver_id") @db.Uuid
  receiver   Receiver? @relation(fields: [receiverId], references: [id])

  trackingNum  String?   @map("tracking_num")
  trackingNum2 String?   @map("tracking_num2")
  tripDate     DateTime? @map("trip_date") @db.Timestamptz(6)
  created      DateTime  @default(now()) @db.Timestamptz(6)

  debt   Decimal? @db.Decimal(12, 2)
  value  Decimal? @db.Decimal(12, 2)
  weight Decimal? @db.Decimal(12, 2)

  contents  String?
  store     String?
  service   String?
  groupId   String? @map("group_id")
  location  String?
  iLocation String? @map("i_location")
  notes     String?

  // Source-of-truth hold flags (kept as the underlying facts, same as legacy). `status`
  // below is a derived projection of these plus the Tracking* milestones — see the enum
  // doc comment and fn_recompute_parcel_status for the precedence rule.
  bOnHold    Boolean @default(false) @map("b_on_hold")
  bNotOnHold Boolean @default(false) @map("b_not_on_hold")

  // The 11 milestone timestamp columns (docs/migrations/02-parcels-domain-analysis.md §4) —
  // kept as-is; these are the real event facts. NULL replaces the legacy
  // `len(datetimeCol) > 1` sentinel-string convention — confirm during the ETL backfill
  // (docs/migrations/05-data-migration-strategy.md §3) that this holds for 100% of rows.
  trackingAway             DateTime? @map("tracking_away") @db.Timestamptz(6)
  trackingReceived         DateTime? @map("tracking_received") @db.Timestamptz(6)
  trackingShipped          DateTime? @map("tracking_shipped") @db.Timestamptz(6)
  trackingDelay            DateTime? @map("tracking_delay") @db.Timestamptz(6)
  trackingCustom           DateTime? @map("tracking_custom") @db.Timestamptz(6)
  trackingProcessingCustom DateTime? @map("tracking_processing_custom") @db.Timestamptz(6)
  trackingOffice           DateTime? @map("tracking_office") @db.Timestamptz(6)
  trackingSendRegion       DateTime? @map("tracking_send_region") @db.Timestamptz(6)
  trackingOutDelivery      DateTime? @map("tracking_out_delivery") @db.Timestamptz(6)
  trackingDeliveredSigned  DateTime? @map("tracking_delivered_signed") @db.Timestamptz(6)

  trackingEstDelivery DateTime? @map("tracking_est_delivery") @db.Timestamptz(6)
  trackingEstShip     DateTime? @map("tracking_est_ship") @db.Timestamptz(6)

  trackingReceivedBy        String? @map("tracking_received_by")
  trackingDeliveredSignedBy String? @map("tracking_delivered_signed_by")

  topFlag Boolean @default(false) @map("top_flag")
  awb     String?
  isDr    Boolean @default(false) @map("is_dr")

  // Short human-readable pickup code, shared by every parcel in the same sender/trip group
  // and printed on the group header of the bema parcels list ("Code - 123456"). Set in bulk
  // via the list screen's "Change code" operation, which first warns if the code is already
  // in use elsewhere (legacy `bema/ajax/checkCode.cfm`, now
  // /api/bema/parcels/check-code). Legacy column: `parcels.pCode`.
  pcode String?

  // "The delivery fee for this parcel has been collected." Legacy `bPaidDelivery`: set by the
  // list screen's "Set Status - Paid" operation alongside the invoice/payment it creates, and
  // read back by the Delivery Request (`delreq`) filter to tell paid-for delivery requests
  // apart from unpaid ones. Distinct from `isPaid`, which is trigger-derived from whether an
  // invoice item exists at all.
  bPaidDelivery Boolean @default(false) @map("b_paid_delivery")

  payMethod1 String?  @map("pay_method1")
  payMethod2 String?  @map("pay_method2")
  payAmount1 Decimal? @map("pay_amount1") @db.Decimal(12, 2)
  payAmount2 Decimal? @map("pay_amount2") @db.Decimal(12, 2)

  parcelType   String? @map("parcel_type")
  bNotify      Boolean @default(false) @map("b_notify")
  bNotDeclared Boolean @default(false) @map("b_not_declared")

  length    Decimal? @db.Decimal(10, 2)
  width     Decimal? @db.Decimal(10, 2)
  high      Decimal? @db.Decimal(10, 2)
  dimWeight Decimal? @map("dim_weight") @db.Decimal(10, 2)

  additionalUsername  String?  @map("additional_username")
  additionalFirstname String?  @map("additional_firstname")
  additionalLastname  String?  @map("additional_lastname")
  buser               String?
  onlineSource        String?  @map("online_source")
  balanceAdjust       Decimal? @map("balance_adjust") @db.Decimal(12, 2)

  // Every field the bema parcels list's keyword search looks at — the parcel's own tracking
  // numbers/AWB/"additional" names, plus its receiver's name, organization, city, state and
  // phone — lower-cased into one column, maintained by trigger. Application code only ever
  // reads it.
  //
  // This exists because the search is a *leading-wildcard* match spanning two tables, and no
  // index can serve that across a join: the trigram indexes on `addressbook` are unusable
  // when their predicate is OR-ed with one on `parcels`, so the planner falls back to walking
  // the whole table. Measured at 1M parcels: 1.1-2.9s before, 3ms after. See
  // docs/decisions/0016-parcels-performance.md for the full benchmark.
  searchText String? @map("search_text")

  // --- Phase 1 redesign additions (docs/migrations/04-postgres-schema-design.md §1-2) ---
  // All five of these are maintained by triggers (see migration.sql) — application code
  // must never write them directly; it only ever reads them. This is what eliminates the
  // 8-10 independently-drifted status copies and the six per-row correlated subqueries
  // documented in docs/migrations/02-parcels-domain-analysis.md §2.2 and §7.
  status        ParcelStatus @default(New)
  isPaid        Boolean      @default(false) @map("is_paid")
  isInvoiced    Boolean      @default(false) @map("is_invoiced")
  invoiceId     String?      @map("invoice_id") @db.Uuid
  invoice       Invoice?     @relation("ParcelInvoice", fields: [invoiceId], references: [id])
  invoiceAmount Decimal      @default(0) @map("invoice_amount") @db.Decimal(12, 2)
  officeName    String?      @map("office_name")

  invoiceItems  InvoiceItem[]
  parcelOffice  ParcelOffice?
  statusHistory ParcelStatusHistory[]
  editHistory   ParcelHistory[]

  @@index([tripDate, id], map: "parcels_trip_date_id_idx")
  @@index([status])
  @@index([userId])
  @@index([receiverId])
  @@index([created])
  @@index([trackingNum])
  @@index([pcode])
  // The bema parcels list's "Received By" filter (legacy `eadmin`), which is also the
  // implicit default filter for a BemaAgent and for an unfiltered first page load.
  @@index([trackingReceivedBy])
  @@map("parcels")
}

// --- Site Pages CMS (bema "Site Pages" — see docs/decisions/0013-site-pages-cms.md) --------
// Legacy (MSSQLPageDAO.cfc) keeps only metadata in its `pages` table (Url/Type/Name/dates) —
// the actual editable content is serialized to a JSON file on disk keyed by SHA-1(url), read
// on every request instead of hitting the DB, specifically to avoid a per-request DB read.
// This redesign keeps content in Postgres like everything else (no reason to hand-roll a
// file cache when Next.js's own ISR/on-demand revalidation gives the same "don't regenerate
// unless something changed" property — see the site pages catch-all route) — `slug`+`locale`
// (not the full legacy `url`, which had `/ge/`-prefixed duplicates for the Georgian version)
// is the natural key once next-intl's `[locale]` segment already owns the locale prefix.
//
// Deliberately not modeled (legacy fields confirmed always empty/constant across all 77
// pages in the actual production content dump, see docs/decisions/0013 — not a guess):
// `Type` (always 1), `Mobile` (mobile-specific content override, always empty), `Groups`
// (front-end customer-group visibility ACL, always empty — same "out of scope" call as
// customer discount tiers in docs/decisions/0011-bema-admin.md).
model Page {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String
  locale          String  @default("en")
  name            String
  // Legacy `Header` field — present on ~half of real pages but not referenced by the
  // generic `views/static.html` template that renders most of them; its actual display
  // purpose wasn't established from the legacy code (see docs/decisions/0013). Kept for
  // field-parity/import fidelity, not yet rendered anywhere on the public page.
  header          String?
  content         String
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([locale, slug])
  @@map("pages")
}
