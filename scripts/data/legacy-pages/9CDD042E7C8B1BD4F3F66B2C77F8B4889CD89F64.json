{"metaDescription":"","name":"GE Letter Form","metaTitle":"Letter Form","mobile":"","content":"<div class=\"documents-page\">\r\n        <div class=\"page-heading\">\r\n            <div class=\"container\">\r\n                <div class=\"breadcrumbs\">\r\n                    <a href=\"\">მთავარი</a>\r\n                    <span class=\"sep\">></span>\r\n                    <span class=\"current\">წერილის ფორმები</span>\r\n                </div>\r\n\r\n                <h1>წერილის ფორმები</h1>\r\n            </div>\r\n        </div>\r\n\r\n        <section class=\"documents\">\r\n            <div class=\"container\">\r\n                <div class=\"intro\"><p>ინტერნეტ შესყიდვა - სასარგებლო, დროის და სასხსრების დამზოგავი პროცესია, მაგრამ სამწუხაროდ თან ახლავს მცირე ხარვეზები რომელთა აღმოფხვრაში ქვემოთ მოცემული წერილები დაგეხმარებათ. მცირე დეტალების შეცვლით მზა წერილი გექნებათ მაღაზიისთვის გასაგზავნად.</p></div>\r\n\r\n                <div class=\"documents-list\">\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">ამანათის ნომრის მოთხოვნა</div>\r\n                            <p>ზოგჯერ მაღაზია არ აგზავნის ამანათის ნომერის, რომელიც დეკლარირებისთვის აუცილებელია.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">შეკვეთას აკლია ნივთი</div>\r\n                            <p>იშვიათდ, მაგრამ ზოგჯერ ასეც ხდება, ამ პრობლემის გადასაჭრელად ეს ფორმა დაგეხმარებათ.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">სად არის ჩემი ამანათი?</div>\r\n                            <p>გამორჩენილი შეკვეთის ან სხვა მიზეზის გამო დაგვიანევისას გამოიყენეთ წერილის ეს ფორმა.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">შეცდომა შეკვეთაში</div>\r\n                            <p>იმ შემთხვეაში, აღმოჩინეთ ნივთი რომელიც არ შეგიკვეთავთ, დაუყოვნებლივ მიმართეთ მაღაზიას.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">შეკვეთის გაუქმება</div>\r\n                            <p>თუ რაიმე მიზეზის გამო შეკვეთის გაუქმება გადაწყვიტეთ, აქ ნახავთ მზა წერილს მაღაზიისთვის.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"item\">\r\n                        <i class=\"icon icon-doc\"></i>\r\n                        <div class=\"item-r\">\r\n                            <div class=\"title\">თანხის დაბრუნება</div>\r\n                            <p>ზოგჯერ მაღაზია აუქმებს შეკვეთას და თანხის დასაბრუნებლად უნდა გაუგზავნეოთ წერილი.</p>\r\n                            <div class=\"links\">\r\n                                <a href=\"\">ნახვა</a> <a href=\"\">ჩამოტვირთვა</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    </div>","header":"","id":81,"groups":[],"url":"/ge/letterform.html","metaKeywords":"","type":1}